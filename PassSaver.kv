<CrrPopup@Popup>
    auto_dismiss:False
    title:
        ""
    separator_height: 0
    size_hint:0.5,0.8
    pos:50,50
    backround_normal:''
    FloatLayout
        border:50

        padding:10,10,10,10
        orientation:"vertical"
        background_color:(0,0,0,0)

        size:root.width,root.height
        border_color: (1,1,1,1)
        canvas.before:
            Color:
                rgba:1,1,1,1
            RoundedRectangle:
                radius:[20]
                size:self.width+40,self.height+60
                pos:self.x-20,self.y-20
        Label:
            text:"Welcome To PassSaver"
            font_name:"Font/QueensidesMedium-x30zV.ttf"
            font_size:30
            color:"black"
            pos_hint:{"center_x":0.5, "center_y":.9}
        Label:
            text:"Create Account For Save Your Passwords"
            font_name:"Font/QueensidesMedium-x30zV.ttf"
            font_size:20
            color:"black"
            pos_hint:{"center_x":0.5, "center_y":.8}
            focus:True

        TextInput:
            id:name
            size_hint:0.8,0.08
            hint_text:"Name"
            pos_hint:{"center_x":0.49, "center_y":.7}
            multiline:False
            font_name:"Font/QueensidesMedium-x30zV.ttf"
            border_color:"black"
        TextInput:
            id:Email
            size_hint:0.8,0.08
            hint_text:"Email"
            pos_hint:{"center_x":0.49, "center_y":.6}
            multiline:False
            font_name:"Font/QueensidesMedium-x30zV.ttf"
        TextInput:
            id:password
            size_hint:0.8,0.08
            hint_text:"Password"
            pos_hint:{"center_x":0.49, "center_y":.5}
            multiline:False
            font_name:"Font/QueensidesMedium-x30zV.ttf"
        TextInput:
            id:cfpassword
            size_hint:0.8,0.08
            hint_text:"Confirm Password"
            pos_hint:{"center_x":0.49, "center_y":.4}
            multiline:False
            font_name:"Font/QueensidesMedium-x30zV.ttf"



        Signin1Button:
            id:S
            text:"Sign up"
            font_name:"Font/QueensidesMedium-x30zV.ttf"
            color:"white"
            pos_hint:{"center_x":0.49, "center_y":.29}
            size_hint:0.5,0.1
            on_press: root.Crr()
        Back1Button:
            text:"<--Back"
            font_name:"Font/QueensidesMedium-x30zV.ttf"
            color:"white"
            pos_hint:{"center_x":0.49, "center_y":.17}
            size_hint:0.5,0.1
            on_release:root.dismiss()
        Label:
            id:Wait
            text:"Please Wait..."
            font_name:"Font/QueensidesMedium-x30zV.ttf"
            font_size:20
            color:"black"
            pos:210,-50
            focus:True
            opacity:0


<Signin1Button@Button>
    background_color:(0,0,0,0)
