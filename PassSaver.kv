#:import Factory kivy.factory.Factory
<SavePopup@Popup>
    auto_dismiss:True
    title:
        ""
    separator_height: 0
    size_hint:0.5,0.8
    pos:50,50
    backround_normal:''
    BoxLayout
        orientation:"vertical"
        background_color:(0,0,0,0)
        size:self.width,self.height
        border_color: (1,1,1,1)
        canvas.before:
            Color:
                rgba:1,1,1,1
            RoundedRectangle:
                radius:[20]
                size:self.width+40,self.height+60
                pos:self.x-20,self.y-20
        FloatLayout

            Label:
                text:"Save Email&Pass"
                font_name:"Font/QueensidesMedium-x30zV.ttf"
                font_size:30
                color:"black"
                pos_hint:{"center_x":0.5,"top":1.5}
            TextInput:
                id:SaveName
                size_hint:0.8,0.08
                hint_text:"Name"
                pos_hint:{"center_x":0.49,"center_y":0.85}
                multiline:False
                font_name:"Font/QueensidesMedium-x30zV.ttf"
            TextInput:
                id:SaveEmail
                size_hint:0.8,0.08
                hint_text:"Email"
                pos_hint:{"center_x":0.49,"center_y":0.75}
                multiline:False
                font_name:"Font/QueensidesMedium-x30zV.ttf"
            TextInput:
                id:Savepassword
                size_hint:0.8,0.08
                hint_text:"Password"
                pos_hint:{"center_x":0.49,"center_y":0.65}
                multiline:False
                font_name:"Font/QueensidesMedium-x30zV.ttf"
            TextInput:
                id:SaveWeb
                size_hint:0.8,0.08
                hint_text:"Web"
                pos_hint:{"center_x":0.49,"center_y":0.55}
                multiline:False
                font_name:"Font/QueensidesMedium-x30zV.ttf"
            TextInput:
                id:SaveAge
                hint_text:"Age"
                size_hint:0.8,0.08
                pos_hint:{"center_x":0.49,"center_y":0.45}
                multiline:False
                font_name:"Font/QueensidesMedium-x30zV.ttf"
            TextInput:
                id:SavePhone
                hint_text:"Phone Number"
                size_hint:0.8,0.08
                pos_hint:{"center_x":0.49,"center_y":0.35}
                multiline:False
                font_name:"Font/QueensidesMedium-x30zV.ttf"
            SaveJPButton:
                text:"Save"
                font_name:"Font/QueensidesMedium-x30zV.ttf"
                size_hint:0.8,0.08
                pos_hint:{"center_x":0.49,"center_y":0.25}
                on_press:root.Save()

            JPDButton:
                text:"<--Back"
                font_name:"Font/QueensidesMedium-x30zV.ttf"
                size_hint:0.8,0.08
                pos_hint:{"center_x":0.49,"center_y":0.15}
                color:"white"
                on_release:root.dismiss()

<JPDButton@Button>
    background_color:(0,0,0,0)
    background_normal:""
    canvas.before:
        Color:
            rgba:(28/255,75/255,179/255,1)
        RoundedRectangle:
            pos:self.pos
            size:self.size
            radius:[10]

<SaveJPButton@Button>
    background_color:(0,0,0,0)
    background_normal:""
    canvas.before:
        Color:
            rgba:(28/255,75/255,179/255,1)
        RoundedRectangle:
            pos:self.pos
            size:self.size
            radius:[10]
<GenPopup@Popup>
    auto_dismiss:True
    title:
        ""
    separator_height: 0
    size_hint:0.5,0.8
    pos:50,50
    backround_normal:''
    BoxLayout
        orientation:"vertical"
        background_color:(0,0,0,0)
        size:self.width,self.height
        border_color: (1,1,1,1)
        canvas.before:
            Color:
                rgba:1,1,1,1
            RoundedRectangle:
                radius:[20]
                size:self.width+40,self.height+60
                pos:self.x-20,self.y-20
        FloatLayout

            Label:
                text:"Email&Password Generator"
                font_name:"Font/QueensidesMedium-x30zV.ttf"
                font_size:30
                color:"black"
                pos_hint:{"center_x":0.5,"top":1.5}
            TextInput:
                id:GenSaveEmail
                size_hint:0.8,0.08
                hint_text:"Generated Email"
                pos_hint:{"center_x":0.49,"center_y":0.85}
                multiline:False
                font_name:"Font/QueensidesMedium-x30zV.ttf"
                border_color:"white"
            TextInput:
                id:GenSavePassword
                size_hint:0.8,0.08
                hint_text:"Generated password"
                pos_hint:{"center_x":0.49,"center_y":0.75}
                multiline:False
                font_name:"Font/QueensidesMedium-x30zV.ttf"

            GenSaveButton:
                text:"Generate"
                font_name:"Font/QueensidesMedium-x30zV.ttf"
                size_hint:0.8,0.08
                pos_hint:{"center_x":0.49,"center_y":0.65}
                color:"white"
                on_press:root.Core_Genration()


            GenJPButton:
                text:"<--Back"
                font_name:"Font/QueensidesMedium-x30zV.ttf"
                size_hint:0.8,0.08
                pos_hint:{"center_x":0.49,"center_y":0.55}
                color:"white"
                on_release:root.dismiss()
            Label:
                text:
                    "Upper Case"
                font_name:"Font/QueensidesMedium-x30zV.ttf"
                color:"black"
                pos_hint:{"center_x":0.28,"center_y":0.45}
            CheckBox:
                on_active:root.Upper(self,self.active)
                text:"Upper Case"
                color:"black"
                size_hint:0.2,0.02
                pos_hint:{"center_x":0.13,"center_y":0.45}
            Label:

                text:
                    "Lower Case"
                font_name:"Font/QueensidesMedium-x30zV.ttf"
                color:"black"
                pos_hint:{"center_x":0.28,"center_y":0.35}
            CheckBox:
                on_active:root.Lower(self,self.active)
                text:"Lower Case"
                color:"black"
                size_hint:0.2,0.02
                pos_hint:{"center_x":0.13,"center_y":0.35}
            Label:
                text:
                    "Symbols"
                font_name:"Font/QueensidesMedium-x30zV.ttf"
                color:"black"
                pos_hint:{"center_x":0.28,"center_y":0.25}
            CheckBox:
                on_active:root.Symbols(self,self.active)
                text:"Symbols"
                color:"black"
                size_hint:0.2,0.02
                pos_hint:{"center_x":0.13,"center_y":0.25}
            Label:
                text:
                    "Number"
                font_name:"Font/QueensidesMedium-x30zV.ttf"
                color:"black"
                pos_hint:{"center_x":0.28,"center_y":0.15}
            CheckBox:
                on_active:root.Numbers(self,self.active)
                text:"Upper Case"
                color:"black"
                size_hint:0.2,0.02
                pos_hint:{"center_x":0.13,"center_y":0.15}
            GenerateSaveButton:
                text:"Save"
                color:"white"
                size_hint:.4,.2
                pos_hint:{"center_x":0.68,"center_y":0.22}
                on_press:root.SaveInf()
            TextInput:
                id:GenSaveName
                size_hint:0.4,0.08
                hint_text:"Name"
                pos_hint:{"center_x":0.68,"center_y":0.40}
                multiline:False
                font_name:"Font/QueensidesMedium-x30zV.ttf"

<GenerateSaveButton@Button>
    background_color:(0,0,0,0)
    background_normal:""
    canvas.before:
        Color:
            rgba:(28/255,75/255,179/255,1)
        RoundedRectangle:
            pos:self.pos
            size:self.size
            radius:[10]


<GenJPButton@Button>
    background_color:(0,0,0,0)
    background_normal:""
    canvas.before:
        Color:
            rgba:(28/255,75/255,179/255,1)
        RoundedRectangle:
            pos:self.pos
            size:self.size
            radius:[10]

<GenSaveButton@Button>
    background_color:(0,0,0,0)
