<LoginPopup@Popup>
    auto_dismiss:False
    title:
        ""
    separator_height: 0
    size_hint:0.5,0.8
    pos:50,50
    backround_normal:''
    FloatLayout
        border:50

        padding:10,10,10,10
        orientation:"vertical"
        background_color:(0,0,0,0)

        size:root.width,root.height
        border_color: (1,1,1,1)
        canvas.before:
            Color:
                rgba:1,1,1,1
            RoundedRectangle:
                radius:[20]
                size:self.width+40,self.height+60
                pos:self.x-20,self.y-20
        Label:
            text:"Welcome Back!"
            font_name:"Font/QueensidesMedium-x30zV.ttf"
            font_size:30
            color:"black"
            pos_hint:{"center_x":0.5, "center_y":.9}
        Label:
            text:"Login For Manage Your Passwords"
            font_name:"Font/QueensidesMedium-x30zV.ttf"
            font_size:20
            color:"black"
            pos_hint:{"center_x":0.5, "center_y":.8}
            focus:True

        TextInput:
            id:Email
            size_hint:0.8,0.08
            hint_text:"Email"

            multiline:False
            font_name:"Font/QueensidesMedium-x30zV.ttf"
            border_color:"black"
            pos_hint:{"center_x":0.49, "center_y":.7}
        TextInput:
            id:password
            size_hint:0.8,0.08
            hint_text:"Password"
            pos_hint:{"center_x":0.49, "center_y":.6}
            multiline:False
            font_name:"Font/QueensidesMedium-x30zV.ttf"
            password:True
            password_mask:"•"

        SigninButton:
            text:"Sign in"
            font_name:"Font/QueensidesMedium-x30zV.ttf"
            color:"white"
            pos_hint:{"center_x":0.49, "center_y":.38}
            size_hint:0.5,0.1
            on_press:root.Login()


        BackButton:
            text:"<--Back"
            font_name:"Font/QueensidesMedium-x30zV.ttf"
            color:"white"
            pos_hint:{"center_x":0.49, "center_y":.27}
            size_hint:0.5,0.1
            on_release:root.dismiss()
<InfReader@Popup>
    auto_dismiss:True
    title:
        ""
    separator_height: 0
    size_hint:0.5,0.8
    pos:50,50
    backround_normal:''
    BoxLayout
        orientation:"vertical"
        background_color:(0,0,0,0)
        size:self.width,self.height
        border_color: (1,1,1,1)
        canvas.before:
            Color:
                rgba:1,1,1,1
            RoundedRectangle:
                radius:[20]
                size:self.width+40,self.height+60
                pos:self.x-20,self.y-20
        FloatLayout
            Label:
                text:"Reader Center"
                font_name:"Font/QueensidesMedium-x30zV.ttf"
                font_size:30
                color:"black"
                pos_hint:{"center_x":0.5,"top":1.5}
            Label:
                text:"All File Reader it under Development"
                font_name:"Font/QueensidesMedium-x30zV.ttf"
                font_size:15
                color:"black"
                pos_hint:{"center_x":0.49,"center_y":0.67}
            TextInput:
                id:PassName
                size_hint:0.8,0.08
                hint_text:"Name of Element For Read"
                pos_hint:{"center_x":0.49,"center_y":0.85}
                multiline:False
                font_name:"Font/QueensidesMedium-x30zV.ttf"
                border_color:"black"
            TextInput:
                id:Main
                size_hint:0.8,0.08
                hint_text:"Main Password For Confirmation"
                pos_hint:{"center_x":0.49,"center_y":0.75}
                multiline:False
                font_name:"Font/QueensidesMedium-x30zV.ttf"
            AccessButton:
                text:"Access to Information"
                color:"white"
                font_name:"Font/QueensidesMedium-x30zV.ttf"
                size_hint:0.8,0.08
                pos_hint:{"center_x":0.49,"center_y":0.58}
                on_press:root.Read()
            TextInput:
                id:OutEmail
                size_hint:0.8,0.08
                hint_text:"Email"
                pos_hint:{"center_x":0.49,"center_y":0.45}
                multiline:False
                font_name:"Font/QueensidesMedium-x30zV.ttf"
            TextInput:
                id:Outpassword
                size_hint:0.8,0.08
                hint_text:"Password"
                pos_hint:{"center_x":0.49,"center_y":0.35}
                multiline:False
                font_name:"Font/QueensidesMedium-x30zV.ttf"
            TextInput:
                id:OutWeb
                size_hint:0.8,0.08
                hint_text:"Web"
                pos_hint:{"center_x":0.49,"center_y":0.25}
                multiline:False
                font_name:"Font/QueensidesMedium-x30zV.ttf"

            TextInput:
                id:OutAge
                hint_text:"Age"
                size_hint:0.8,0.08
                pos_hint:{"center_x":0.49,"center_y":0.15}
                multiline:False
                font_name:"Font/QueensidesMedium-x30zV.ttf"

            TextInput:
                id:OutPhone
                hint_text:"Phone Number"
                size_hint:0.8,0.08
                pos_hint:{"center_x":0.49,"center_y":0.05}
                multiline:False
                font_name:"Font/QueensidesMedium-x30zV.ttf"


