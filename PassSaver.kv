<PassSaverFirst>
    id:first
    RelativeLayout
        Image:
            source:"img\\Gg.png"
            size_hint:1.1,1.4
            pos_hint:{"center_x":0.2 ,"center_y":0.5}
        Label:
            text:"Saad Studio\n  PassSaver"
            font_name:"Font/QueensidesMedium-x30zV.ttf"
            font_size:50
            color:"black"
            pos_hint:{"center_x":0.77,"center_y":0.8}
        Label:
            text:"Version 1.7.1"
            font_name:"Font/QueensidesMedium-x30zV.ttf"
            font_size:20
            color:"black"
            pos_hint:{"center_x":0.77,"center_y":0.1}
        Label:
            text:"Or"
            font_name:"Font/QueensidesMedium-x30zV.ttf"
            font_size:20
            color:"black"
            pos_hint:{"center_x":0.77,"center_y":0.5}
        Button:
            pos_hint:{"center_x":0.77,"center_y":0.6}
            size_hint:0.3,.08
            background_color:(0,0,0,0)
            background_normal:""
            canvas.before:
                Color:
                    rgba:(28/255,75/255,179/255,1)
                RoundedRectangle:
                    pos:self.pos
                    size:self.size
                    radius:[20]
            text:"Sign in"
            font_name:"Font/QueensidesMedium-x30zV.ttf"
            color:"white"
            on_release:Factory.LoginPopup().open()
        Button:
            pos_hint:{"center_x":0.77,"center_y":0.4}
            size_hint:0.3,.08
            background_color:(0,0,0,0)
            background_normal:""
            canvas.before:
                Color:
                    rgba:(28/255,75/255,179/255,1)
                RoundedRectangle:
                    pos:self.pos
                    size:self.size
                    radius:[20]
            text:"New User"
            font_name:"Font/QueensidesMedium-x30zV.ttf"
            color:"white"
            on_release:Factory.CrrPopup().open()
        Button:
            pos_hint:{"center_x":0.77,"center_y":0.3}
            size_hint:0.3,.08
            background_color:(0,0,0,0)
            background_normal:""
            canvas.before:
                Color:
                    rgba:(28/255,75/255,179/255,1)
                RoundedRectangle:
                    pos:self.pos
                    size:self.size
                    radius:[20]
            text:"Guest"
            font_name:"Font/QueensidesMedium-x30zV.ttf"
            color:"white"
            on_press:root.Guest()







<PassSaverSecond>
    RelativeLayout
        Label:
            id:start
            text:"Let Get Started!"
            color:"#A7AFED"
            font_name:"Font/QueensidesMedium-x30zV.ttf"
            color:"black"
            font_size:65
            pos_hint:{"center_x":0.5,"center_y":0.75}
        SaveButton:
            text:"Save Email&Password"
            font_name:"Font/QueensidesMedium-x30zV.ttf"
            color:"white"
            size_hint:0.6,0.1
            pos_hint:{"center_x":0.5,"center_y":0.54}
            on_release:Factory.SavePopup().open()
        Generate1Button:
            text:"Generate Email&Password"
            font_name:"Font/QueensidesMedium-x30zV.ttf"
            color:"white"
            size_hint:0.6,0.1
            pos_hint:{"center_x":0.5,"top":0.37}
            on_release:Factory.GenPopup().open()

        Generate2Button:
            text:"Generate Password"
            font_name:"Font/QueensidesMedium-x30zV.ttf"
            color:"white"
            size_hint:0.6,0.1
            on_release:Factory.PasswordGenSave().open()
            pos_hint:{"center_x":0.5,"top":0.48}
        ReadButton:
            text:"Read Email&Password"
            font_name:"Font/QueensidesMedium-x30zV.ttf"
            color:"white"
            size_hint:0.6,0.1
            pos_hint:{"center_x":0.5,"top":0.25999999999999}
            on_release:Factory.InfReader().open()
        EncButton:
            text:"File Encrypter"
            font_name:"Font/QueensidesMedium-x30zV.ttf"
            color:"white"
            size_hint:0.6,0.1
            pos_hint:{"center_x":0.5,"center_y":0.1}
            on_press:root.FileEnc()
        Image:
            source:"img/user.png"
            size_hint:.08,.08
            pos_hint:{"center_x":0.1,"center_y":0.9}
        Label:
            id:user
            text:""
            color:"#A7AFED"
            font_name:"Font/QueensidesMedium-x30zV.ttf"
            font_size:40
            pos_hint:{"center_x":.23,"center_y":0.89}
            color:"black"
        Button:
            background_normal:"img/log-out.png"
            background_down:"img/log-out.png"
            on_press:root.Exit()
            size_hint:.15,.19
            pos_hint:{"center_x":0.9,"center_y":0.9}
